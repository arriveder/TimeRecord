<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.notifications.NotificationsFragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_loose">

            <!-- Title with settings icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_normal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="统计数据"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textFontWeight="500"
                    android:textColor="@color/text_primary"
                    tools:targetApi="p" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/title_settings"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_normal">

                <!-- Total Records -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_tight"
                    app:cardCornerRadius="@dimen/corner_medium"
                    app:cardElevation="@dimen/card_elevation_minimal"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_loose"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_total_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="normal"
                            android:textFontWeight="500"
                            android:textColor="@color/primary"
                            tools:targetApi="p" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tight"
                            android:text="总记录"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Today Records -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_tight"
                    app:cardCornerRadius="@dimen/corner_medium"
                    app:cardElevation="@dimen/card_elevation_minimal"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_loose"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_today_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="normal"
                            android:textFontWeight="500"
                            android:textColor="@color/primary"
                            tools:targetApi="p" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tight"
                            android:text="今日"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Week/Month Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_normal">

                <!-- Week Records -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_tight"
                    app:cardCornerRadius="@dimen/corner_medium"
                    app:cardElevation="@dimen/card_elevation_minimal"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_loose"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_week_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="normal"
                            android:textFontWeight="500"
                            android:textColor="@color/primary"
                            tools:targetApi="p" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tight"
                            android:text="本周"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Month Records -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_tight"
                    app:cardCornerRadius="@dimen/corner_medium"
                    app:cardElevation="@dimen/card_elevation_minimal"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_loose"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_month_records"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="normal"
                            android:textFontWeight="500"
                            android:textColor="@color/primary"
                            tools:targetApi="p" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tight"
                            android:text="本月"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Label Statistics - Flat card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                app:cardCornerRadius="@dimen/corner_medium"
                app:cardElevation="@dimen/card_elevation_minimal"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_loose">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标签统计"
                        android:textSize="15sp"
                        android:textStyle="normal"
                        android:textFontWeight="500"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        tools:targetApi="p" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_label_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_no_labels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无标签统计"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="@dimen/spacing_loose"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Date Statistics - Flat card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_medium"
                app:cardElevation="@dimen/card_elevation_minimal"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_loose">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日期统计"
                        android:textSize="15sp"
                        android:textStyle="normal"
                        android:textFontWeight="500"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        tools:targetApi="p" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_date_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_no_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无记录"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:padding="@dimen/spacing_loose"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
